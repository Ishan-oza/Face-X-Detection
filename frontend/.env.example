# Copy to .env.local to override settings for this machine.

# Where the Vite dev/preview server proxies /api. Default: http://127.0.0.1:8000.
# Change it if the FastAPI backend runs on another port, e.g. when 8000 is
# taken by a different project:
# API_PROXY_TARGET=http://127.0.0.1:8001

# Base URL of the FastAPI backend for production builds served from a
# different origin than the API, e.g. https://api.example.com. Leave empty
# when using the dev proxy.
VITE_API_BASE_URL=
